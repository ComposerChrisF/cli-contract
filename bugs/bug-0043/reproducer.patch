+/// The rustdoc of `check_output_file` and `prepare_output_file` lists the refusals on the file
+/// itself "in every mode"; the code also refuses an absent file whose path ends in `..` as
+/// `PathError::DotDotAfterMissing` in every mode (CHANGELOG 0.6.1), so the list must name it.
+#[test]
+fn output_file_rustdoc_names_dotdot_after_missing() {
+    let d = tempfile::tempdir().unwrap();
+    let p = d.path().join("x/a/..");
+    for mode in MODES {
+        let r = check_output_file(&p, mode, Clobber::Allow);
+        assert!(matches!(r, Err(PathError::DotDotAfterMissing(_))), "{mode:?}: {r:?}");
+    }
+    let src = include_str!("../src/paths.rs");
+    for f in ["pub fn check_output_file(", "pub fn prepare_output_file("] {
+        let at = src.find(f).expect(f);
+        let doc: String = src[..at]
+            .lines()
+            .rev()
+            .take_while(|l| l.trim_start().starts_with("///"))
+            .collect();
+        assert!(
+            doc.contains("DotDotAfterMissing"),
+            "doc drift: the rustdoc of {f} omits PathError::DotDotAfterMissing, refused in every mode"
+        );
+    }
+}
