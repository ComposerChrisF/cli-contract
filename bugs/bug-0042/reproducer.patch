+        let d = tmp("semver_dotdot");
+        let dest = d.join("new").join("..").join("new");
+        let r = ensure_destination(&dest, &DestPolicy::Create(CreateMode::All));
+        let version = env!("CARGO_PKG_VERSION");
+        let compatible_with_0_6_0 = version.starts_with("0.6.");
+        let _ = std::fs::remove_dir_all(&d);
+        assert!(
+            !compatible_with_0_6_0 || r.is_ok(),
+            "version {version} is semver-compatible with 0.6.0, but ensure_destination now \
+             refuses the link-free `new/../new` under All, which 0.6.0 built: {r:?}"
+        );
+    }
